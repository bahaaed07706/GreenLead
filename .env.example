APP_NAME=GreenLead
APP_ENV=development

# --- Branding: adapt the platform to your own organization ----------------
# Labels and defaults only — no business logic depends on them.
# Full guide: docs/CUSTOMIZATION.md
ORG_NAME=Your Company
ORG_INDUSTRY=Technology
APP_DESCRIPTION=Business-development & sales-intelligence platform
# --------------------------------------------------------------------------
APP_DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
SECRET_KEY=replace-with-secure-secret

# Force the Secure flag on the session cookie. Leave empty to follow APP_ENV
# (secure only when APP_ENV=production). Set to true when the app is served
# over HTTPS but is not running as APP_ENV=production — e.g. a public demo.
SESSION_COOKIE_SECURE=

ADMIN_USERNAME=admin
# Generate your own bcrypt hash — never reuse one from a public repo:
#   python -c "from passlib.hash import bcrypt; print(bcrypt.hash('your-password'))"
ADMIN_PASSWORD_HASH=replace-with-your-own-bcrypt-hash

# Persistence backend.
#   Empty            -> in-memory (data lost on restart; dev/tests only)
#   SQLite (local)   -> DATABASE_URL=sqlite:///./greenlead.db   (survives restart)
#   PostgreSQL (prod)-> DATABASE_URL=postgresql+psycopg://user:pass@host:5432/greenlead
#                       (install the driver: pip install -e ".[postgres]")
DATABASE_URL=

AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=

TAVILY_API_KEY=

# Google Sheets Data Store (Phase 3)
# Leave both empty to use in-memory repository (no credentials required).
# To connect to a real Google Sheet:
#   1. Create a GCP project and enable Google Sheets API + Google Drive API.
#   2. Create a Service Account, download its JSON key file.
#   3. Share the target spreadsheet with the service account email (Editor).
#   4. Set GOOGLE_SHEET_ID to the spreadsheet ID from its URL.
#   5. Set GOOGLE_SERVICE_ACCOUNT_FILE to the absolute path of the JSON key.
#   6. Ensure the JSON key file is NOT inside the repository.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=

